{
  "hosting": {
    "site": "gravecare-ops",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/login.html",
        "destination": "/login-ops.html"
      },
      {
        "source": "/",
        "destination": "/login-ops.html"
      }
    ]
  }
}